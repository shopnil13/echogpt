// EchoGPT database schema.
// Conventions: PascalCase models mapped to snake_case plural tables, UUIDv7 keys,
// timestamptz everywhere. Constraints Prisma cannot express (partial unique indexes,
// check constraints) live in hand-written migration SQL and are noted with `///`.
// Design notes: echogpt-notes/docs/database.md

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  ACTIVE
  SUSPENDED

  @@map("user_status")
}

enum SessionRevokeReason {
  LOGOUT
  LOGOUT_ALL
  PASSWORD_CHANGED
  REUSE_DETECTED
  USER_SUSPENDED
  ADMIN_REVOKED

  @@map("session_revoke_reason")
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("verification_purpose")
}

enum LimitPeriod {
  DAILY
  MONTHLY

  @@map("limit_period")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED

  @@map("subscription_status")
}

enum ProviderType {
  OPENAI
  ANTHROPIC
  GEMINI
  MOCK

  @@map("provider_type")
}

enum ProviderHealthStatus {
  UNKNOWN
  HEALTHY
  UNHEALTHY

  @@map("provider_health_status")
}

enum MessageRole {
  SYSTEM
  USER
  ASSISTANT

  @@map("message_role")
}

enum MessageStatus {
  COMPLETED
  FAILED

  @@map("message_status")
}

enum UsageFeature {
  CHAT
  SEARCH

  @@map("usage_feature")
}

// ---------------------------------------------------------------------------
// Identity and access
// ---------------------------------------------------------------------------

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique @db.VarChar(32)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  users User[]

  @@map("roles")
}

model User {
  id              String     @id @default(uuid(7)) @db.Uuid
  /// Stored trimmed and lower-cased.
  email           String     @unique @db.VarChar(254)
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  fullName        String     @map("full_name") @db.VarChar(100)
  avatarUrl       String?    @map("avatar_url") @db.VarChar(2048)
  roleId          String     @map("role_id") @db.Uuid
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  role               Role                @relation(fields: [roleId], references: [id], onDelete: Restrict)
  sessions           Session[]
  verificationTokens VerificationToken[]
  subscriptions      Subscription[]
  usageCounters      UsageCounter[]
  conversations      Conversation[]
  webSearches        WebSearch[]
  apiUsageLogs       ApiUsageLog[]

  @@index([roleId])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

/// One row per signed-in device. The refresh token is `<id>.<secret>`; only sha256(secret) is stored
/// and it is rotated on every refresh.
model Session {
  id               String               @id @default(uuid(7)) @db.Uuid
  userId           String               @map("user_id") @db.Uuid
  refreshTokenHash String               @map("refresh_token_hash") @db.Char(64)
  userAgent        String?              @map("user_agent") @db.VarChar(512)
  ipAddress        String?              @map("ip_address") @db.VarChar(64)
  expiresAt        DateTime             @map("expires_at") @db.Timestamptz(3)
  lastUsedAt       DateTime             @default(now()) @map("last_used_at") @db.Timestamptz(3)
  revokedAt        DateTime?            @map("revoked_at") @db.Timestamptz(3)
  revokedReason    SessionRevokeReason? @map("revoked_reason")
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model VerificationToken {
  id        String              @id @default(uuid(7)) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  purpose   VerificationPurpose
  tokenHash String              @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime            @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?           @map("used_at") @db.Timestamptz(3)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Plans, subscriptions and quotas
// ---------------------------------------------------------------------------

model Plan {
  id           String      @id @default(uuid(7)) @db.Uuid
  /// Stable identifier used by clients, e.g. `free`, `premium`.
  code         String      @unique @db.VarChar(32)
  name         String      @db.VarChar(64)
  description  String?     @db.VarChar(255)
  priceCents   Int         @default(0) @map("price_cents")
  currency     String      @default("USD") @db.Char(3)
  requestLimit Int         @map("request_limit")
  limitPeriod  LimitPeriod @default(DAILY) @map("limit_period")
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  subscriptions Subscription[]

  @@map("plans")
}

/// Plan changes insert a new ACTIVE row and cancel the previous one, keeping full history.
/// Invariant (raw SQL): at most one ACTIVE subscription per user.
model Subscription {
  id                 String             @id @default(uuid(7)) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime           @default(now()) @map("current_period_start") @db.Timestamptz(3)
  currentPeriodEnd   DateTime?          @map("current_period_end") @db.Timestamptz(3)
  canceledAt         DateTime?          @map("canceled_at") @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@index([planId, status])
  @@map("subscriptions")
}

/// One row per user per quota window, incremented atomically with a conditional upsert.
model UsageCounter {
  id           String      @id @default(uuid(7)) @db.Uuid
  userId       String      @map("user_id") @db.Uuid
  periodStart  DateTime    @map("period_start") @db.Timestamptz(3)
  period       LimitPeriod
  requestCount Int         @default(0) @map("request_count")
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStart])
  @@map("usage_counters")
}

// ---------------------------------------------------------------------------
// AI providers
// ---------------------------------------------------------------------------

/// Invariants (raw SQL): at most one row with is_default = true; a default provider must be enabled.
model AiProvider {
  id                  String               @id @default(uuid(7)) @db.Uuid
  name                String               @unique @db.VarChar(64)
  type                ProviderType
  baseUrl             String?              @map("base_url") @db.VarChar(2048)
  /// AES-256-GCM ciphertext in the format `v1:<iv>:<tag>:<data>`. Never returned by the API.
  apiKeyEncrypted     String?              @map("api_key_encrypted")
  apiKeyLast4         String?              @map("api_key_last4") @db.VarChar(4)
  defaultModel        String               @map("default_model") @db.VarChar(128)
  isEnabled           Boolean              @default(false) @map("is_enabled")
  isDefault           Boolean              @default(false) @map("is_default")
  timeoutMs           Int?                 @map("timeout_ms")
  healthStatus        ProviderHealthStatus @default(UNKNOWN) @map("health_status")
  lastHealthCheckAt   DateTime?            @map("last_health_check_at") @db.Timestamptz(3)
  lastHealthLatencyMs Int?                 @map("last_health_latency_ms")
  lastHealthError     String?              @map("last_health_error") @db.VarChar(500)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  models        AiModel[]
  conversations Conversation[]
  messages      Message[]
  apiUsageLogs  ApiUsageLog[]

  @@map("ai_providers")
}

model AiModel {
  id          String   @id @default(uuid(7)) @db.Uuid
  providerId  String   @map("provider_id") @db.Uuid
  /// The provider's own model identifier, e.g. `claude-sonnet-5`.
  name        String   @db.VarChar(128)
  displayName String   @map("display_name") @db.VarChar(128)
  isEnabled   Boolean  @default(true) @map("is_enabled")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  provider AiProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, name])
  @@map("ai_models")
}

// ---------------------------------------------------------------------------
// Chat
// ---------------------------------------------------------------------------

model Conversation {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  title         String    @db.VarChar(200)
  /// Preferred provider for new messages; individual messages record what actually answered.
  providerId    String?   @map("provider_id") @db.Uuid
  model         String?   @db.VarChar(128)
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider AiProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  messages Message[]

  @@index([userId, updatedAt(sort: Desc)])
  @@index([providerId])
  @@map("conversations")
}

model Message {
  id               String        @id @default(uuid(7)) @db.Uuid
  conversationId   String        @map("conversation_id") @db.Uuid
  role             MessageRole
  content          String
  status           MessageStatus @default(COMPLETED)
  providerId       String?       @map("provider_id") @db.Uuid
  model            String?       @db.VarChar(128)
  promptTokens     Int?          @map("prompt_tokens")
  completionTokens Int?          @map("completion_tokens")
  latencyMs        Int?          @map("latency_ms")
  errorCode        String?       @map("error_code") @db.VarChar(64)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  provider     AiProvider?  @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([providerId])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Web search
// ---------------------------------------------------------------------------

model WebSearch {
  id              String   @id @default(uuid(7)) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  query           String   @db.VarChar(500)
  /// Trimmed, lower-cased, whitespace-collapsed. Prefix-indexed for suggestions (raw SQL).
  normalizedQuery String   @map("normalized_query") @db.VarChar(500)
  engine          String   @db.VarChar(32)
  resultCount     Int      @map("result_count")
  /// Snapshot of the results so history entries survive cache expiry.
  results         Json     @db.JsonB
  aiSummary       String?  @map("ai_summary")
  fromCache       Boolean  @map("from_cache")
  latencyMs       Int      @map("latency_ms")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("web_searches")
}

/// Shared across users: search results are not personal.
model SearchCacheEntry {
  id              String   @id @default(uuid(7)) @db.Uuid
  /// sha256 hex of engine | normalized query | options.
  cacheKey        String   @unique @map("cache_key") @db.Char(64)
  engine          String   @db.VarChar(32)
  normalizedQuery String   @map("normalized_query") @db.VarChar(500)
  results         Json     @db.JsonB
  hitCount        Int      @default(0) @map("hit_count")
  expiresAt       DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("search_cache_entries")
}

// ---------------------------------------------------------------------------
// Observability
// ---------------------------------------------------------------------------

/// Append-only, one row per API request. `user_id` is nulled when the account is deleted.
model ApiUsageLog {
  id               BigInt        @id @default(autoincrement())
  requestId        String        @map("request_id") @db.VarChar(128)
  userId           String?       @map("user_id") @db.Uuid
  method           String        @db.VarChar(10)
  /// Route pattern (e.g. /api/v1/chat/conversations/:id), not the raw URL.
  route            String        @db.VarChar(255)
  statusCode       Int           @map("status_code")
  durationMs       Int           @map("duration_ms")
  ipAddress        String?       @map("ip_address") @db.VarChar(64)
  userAgent        String?       @map("user_agent") @db.VarChar(512)
  feature          UsageFeature?
  providerId       String?       @map("provider_id") @db.Uuid
  model            String?       @db.VarChar(128)
  promptTokens     Int?          @map("prompt_tokens")
  completionTokens Int?          @map("completion_tokens")
  errorCode        String?       @map("error_code") @db.VarChar(64)
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user     User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider AiProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([feature, createdAt])
  @@index([statusCode, createdAt])
  @@index([providerId])
  @@map("api_usage_logs")
}

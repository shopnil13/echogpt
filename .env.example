# -----------------------------------------------------------------------------
# EchoGPT backend environment. Copy to `.env` and adjust.
# Every variable is validated at boot (src/config/env.validation.ts).
# -----------------------------------------------------------------------------

# --- Application --------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Public base URL of this API (used in links sent by email)
APP_PUBLIC_URL=http://localhost:3000
# Comma-separated CORS allowlist, e.g. the extension origin chrome-extension://<extension-id>
CORS_ORIGINS=http://localhost:5173
# Set to true when running behind a reverse proxy / load balancer
TRUST_PROXY=false
# Maximum JSON body size
BODY_LIMIT=100kb
# Expose Swagger UI at /api/docs
SWAGGER_ENABLED=true
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# --- Database -------------------------------------------------------------------
# docker compose exposes PostgreSQL on 127.0.0.1:5434 (override with POSTGRES_PORT)
DATABASE_URL=postgresql://echogpt:echogpt@localhost:5434/echogpt?schema=public
# Maximum connections in the pg pool of each API instance
DATABASE_POOL_MAX=10

# --- Authentication ------------------------------------------------------------------
# HS256 signing secret, at least 32 characters: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-long-random-secret-of-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Stricter rate limit for login, register, refresh and verification endpoints
AUTH_THROTTLE_LIMIT=10
AUTH_THROTTLE_TTL_SECONDS=60
# Block chat and search until the email address is verified
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_VERIFICATION_TTL_HOURS=24
# Client page that receives ?token=... and calls POST /api/v1/auth/verify-email
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email

# --- Mail --------------------------------------------------------------------------------
# log: print emails to the application log (development only). smtp: send via SMTP.
MAIL_TRANSPORT=log
MAIL_FROM=EchoGPT <no-reply@echogpt.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- AI providers ----------------------------------------------------------------
# 32-byte key (base64) encrypting provider API keys at rest: openssl rand -base64 32
# Losing or changing it makes stored provider keys unreadable.
ENCRYPTION_KEY=
# Enables the keyless MOCK provider (development and reviews). Keep false in production.
AI_MOCK_PROVIDER_ENABLED=true
AI_REQUEST_TIMEOUT_MS=60000
AI_HEALTH_CHECK_TIMEOUT_MS=10000
AI_MAX_OUTPUT_TOKENS=16000

# --- Chat --------------------------------------------------------------------------------
# Number of previous messages sent to the model as context
CHAT_CONTEXT_MESSAGES=20
CHAT_SYSTEM_PROMPT=You are EchoGPT, a helpful, accurate and concise assistant.
# SSE keep-alive comment interval for streaming responses
CHAT_STREAM_HEARTBEAT_MS=15000

# --- Web search ----------------------------------------------------------------------
# mock (deterministic, keyless) or tavily (requires TAVILY_API_KEY)
SEARCH_ENGINE=mock
TAVILY_API_KEY=
# Shared result cache lifetime; 0 disables caching
SEARCH_CACHE_TTL_SECONDS=3600
SEARCH_TIMEOUT_MS=10000
# A query appears in other users' suggestions only after this many distinct users searched it
SEARCH_SUGGESTION_MIN_USERS=3

# --- Rate limiting -------------------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# --- Seed (npm run db:seed) -------------------------------------------------------
SEED_ADMIN_EMAIL=admin@echogpt.local
# At least 12 characters. Change it before seeding any shared environment.
SEED_ADMIN_PASSWORD=ChangeMe!Admin2026
SEED_ADMIN_NAME=EchoGPT Admin
# Optional: bootstrap real providers with encrypted keys on first seed (enables them).
SEED_OPENAI_API_KEY=
SEED_ANTHROPIC_API_KEY=
SEED_GEMINI_API_KEY=
